{
  "version": 2,
  "builds": [
    {
      "src": "dashboard.html",
      "use": "@vercel/static"
    },
    {
      "src": "highway.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "pipeline.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "optogenetics.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "fig.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "12.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/highway\\.pdf",
      "dest": "/highway.pdf"
    },
    {
      "src": "/pipeline\\.pdf",
      "dest": "/pipeline.pdf"
    },
    {
      "src": "/optogenetics\\.pdf",
      "dest": "/optogenetics.pdf"
    },
    {
      "src": "/fig\\.pdf",
      "dest": "/fig.pdf"
    },
    {
      "src": "/12\\.jpg",
      "dest": "/12.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard.html"
    }
  ]
}
